# ePostal Environment Variables Example
# Copy this to .env.local for development

# The Deployment ID from Google Apps Script (clasp deploy).
# Required for local dev proxying through /api. No hard-coded fallback is used.
VITE_GAS_DEPLOY_ID=your_deployment_id_here

# The full deployed GAS Web App URL.
# Required for production builds served outside google.script.run.
VITE_GAS_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# Sentry DSN for Error Monitoring.
VITE_SENTRY_DSN=your_sentry_dsn_here
